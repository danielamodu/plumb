{
  "name": "plumb",
  "version": "1.0.0",
  "description": "OpenAI-compatible verification gateway & live Telegraph miner-reliability scoreboard (Mission 07)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/proxy/cli.ts",
    "start": "tsx src/proxy/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:adversarial": "tsx bench/adversarial.ts",
    "bench:120": "tsx bench/pareto-benchmark.ts",
    "bench:4arm": "tsx bench/live-4arm.ts",
    "bench:payout": "tsx bench/task-fulfillment.ts",
    "check:readme": "node scripts/check-readme.mjs"
  },
  "dependencies": {
    "@solana/web3.js": "^3.2.1",
    "viem": "^2.23.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
