# Server Binding
PLUMB_HOST=127.0.0.1
PLUMB_PORT=8787

# Telegraph Sepolia Escrow Config (Nov 17 Diamond)
TELEGRAPH_NODE_URL=https://devnode.telegraphprotocol.com
TELEGRAPH_DIAMOND=0x72a70e949362670Bf8bceAd24eFC5b8f950aa08b
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional: override ~/.telegraph/wallet.json (throwaway Sepolia key ONLY)
TELEGRAPH_PRIVATE_KEY=
ANJOMAN_API_KEY=

# Atomic USDC Spend Limits
PLUMB_DAILY_LIMIT_USD=5.00
PLUMB_MAX_ASK_USD=0.05
PLUMB_MAX_BUDGET_UUSDC=10000

# Upstream OpenAI-Compatible LLM (defaults to Groq)
UPSTREAM_BASE_URL=https://api.groq.com/openai/v1
UPSTREAM_API_KEY=
UPSTREAM_MODEL=openai/gpt-oss-120b

# Optional 2nd Upstream LLM Failover
UPSTREAM_FALLBACK_BASE_URL=
UPSTREAM_FALLBACK_API_KEY=

# Solana Devnet 2-of-2 Policy Co-Signer
SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional: override auto-generated Devnet keypairs in data/
SOLANA_KEYPAIR_PATH=
SOLANA_COSIGNER_KEYPAIR_PATH=

# Optional Track 01 Same-Author Disclosure (unpinned on /scoreboard)
PRIMARY_MINER_ID=6184
