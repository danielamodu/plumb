# Telegraph Sepolia Escrow Config
TELEGRAPH_URL=https://devnode.telegraphprotocol.com
TELEGRAPH_DIAMOND=0x72a70e949362670Bf8bceAd24eFC5b8f950aa08b
TELEGRAPH_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional: override ~/.telegraph/wallet.json (throwaway Sepolia key ONLY)
TELEGRAPH_PRIVATE_KEY=
TELEGRAPH_MAX_ASK_USD=0.05
TELEGRAPH_DAILY_LIMIT_USD=15.00
TELEGRAPH_MAX_BUDGET_USDC=30000

# Upstream OpenAI-compatible LLM (defaults to Groq)
UPSTREAM_BASE_URL=https://api.groq.com/openai/v1
UPSTREAM_API_KEY=
UPSTREAM_MODEL=openai/gpt-oss-120b

# Optional 2nd Upstream LLM Failover (e.g. OpenRouter / OpenAI / Gemini OpenAI-compat)
UPSTREAM_FALLBACK_BASE_URL=
UPSTREAM_FALLBACK_API_KEY=
UPSTREAM_FALLBACK_MODEL=

# Optional Track 01 disclosure (set to primary's on-chain registration ID once registered)
PRIMARY_MINER_ID=

PORT=3000
HOST=0.0.0.0
